# Dockerfile.gpu - CUDA-enabled Docker image for Indonesia IVR Speech AI
# Optimized for cloud GPU instances (RunPod, AWS EC2 G5/P4, NVIDIA A100/L40S)

# =============================================================================
# Base Image - PyTorch with CUDA 12.1 support
# =============================================================================
FROM pytorch/pytorch:2.2.0-cuda12.1-cudnn8-runtime AS base

# =============================================================================
# System Dependencies
# =============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    libsndfile1-dev \
    libportaudio2 \
    portaudio19-dev \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# Python Dependencies
# =============================================================================
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .
COPY pyproject.toml .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -e .

# =============================================================================
# Model Cache Configuration
# =============================================================================
ENV HF_HOME=/root/.cache/huggingface
ENV TRANSFORMERS_CACHE=/root/.cache/huggingface
ENV SENTENCE_TRANSFORMERS_HOME=/root/.cache/sentence_transformers
ENV TORCH_HOME=/root/.cache/torch

# Pre-download models during build (optional - comment out for faster builds)
# RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('LazarusNLP/all-indo-e5-small-v4')"

# =============================================================================
# Application Code
# =============================================================================
COPY app/ ./app/
COPY scripts/ ./scripts/
COPY tests/ ./tests/
COPY docker/ ./docker/
COPY config/ ./config/

# =============================================================================
# Entry Point
# =============================================================================
EXPOSE 8000 1883 55555

# Default command runs the FastAPI server
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]